#!/bin/sh /etc/rc.common
# wifi-monitor OpenWrt procd service

USE_PROCD=1
START=95
STOP=10

start_service() {
    procd_open_instance
    procd_set_param command /usr/bin/wifi-monitor.sh
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Bring down monitor interfaces cleanly
    ip link set wlan0 down 2>/dev/null || true
    ip link set wlan1 down 2>/dev/null || true
    iw dev wlan0 del 2>/dev/null || true
    iw dev wlan1 del 2>/dev/null || true
}
